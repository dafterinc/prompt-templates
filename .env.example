# Environment mode - Options: 'development', 'production'
# Set to 'production' to test production security settings locally
# This allows you to test production security settings without deploying
APP_ENV=development

# Security-related settings
# These settings are primarily used in production mode

# Set to 'true' to force HTTPS in production
FORCE_HTTPS=true

# Allowed origins for CORS (comma-separated list)
# Example: https://yourdomain.com,https://admin.yourdomain.com
# For local testing with production security: http://localhost:5174
ALLOWED_ORIGINS=https://yourdomain.com

# Rate limiting settings
# Requests per minute per IP
RATE_LIMIT_MAX_REQUESTS=100
# Rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Logging
# Set to 'true' to emit logs to the console in production (development always logs).
PUBLIC_ENABLE_LOGGING=false

# Postgres (Phase 2 migration off Supabase) - SERVER ONLY, never expose to the client.
# Point at your database. If it is behind pgBouncer in transaction mode (port 6432), the driver
# is already configured with prepared statements disabled.
DATABASE_URL=postgresql://user:password@host:6432/dbname?sslmode=require 
# --- Better Auth (Phase 2 - replaces Supabase Auth) --- SERVER ONLY
# 32+ char random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=your-better-auth-secret
# The app's base URL (dev: http://localhost:5173)
BETTER_AUTH_URL=http://localhost:5173

# --- Vercel Blob (Phase 2 storage) --- SERVER ONLY
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# --- Email (SMTP2GO) for password reset --- SERVER ONLY
SMTP2GO_API_KEY=your-smtp2go-api-key
# A sender address verified in your SMTP2GO account
EMAIL_FROM=no-reply@yourdomain.com
